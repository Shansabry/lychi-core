# Rust
**/target
**/*.rs.bk

# Frontend
**/node_modules
**/build
**/.svelte-kit

# Environment
.env
.env.*
*.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Tauri generated icons (keep PNGs, ignore platform-specific)
**/src-tauri/icons/*.ico
**/src-tauri/icons/*.icns
**/src-tauri/icons/android/
**/src-tauri/icons/ios/
**/src-tauri/icons/Square*.png
**/src-tauri/icons/StoreLogo.png
**/src-tauri/icons/AppIcon*.png

# Generated placeholder icon
core/app-icon.png

# Build outputs
**/bundle/
**/*.AppImage
**/*.deb
**/*.rpm
**/*.dmg
**/*.msi

# Logs
*.log
npm-debug.log*

# Generated CLI sidecar artifacts (built by pnpm build:cli)
**/src-tauri/binaries/

# NOTE: src/lib/bindings.ts is deliberately NOT ignored. It's generated, but
# its consumers are TypeScript files, and requiring a Rust toolchain + WebKit
# dev stack to run `pnpm test:fe` is a barrier for frontend contributors.
# Regenerate with `cargo test -p lychi-app export_bindings`; CI regenerates and
# diffs, so a stale copy fails the build rather than drifting silently.

# Generated by `pnpm notices` (cargo-about) at build time and bundled into the
# AppImage. Not committed: derived, 500KB+, and stale the moment a dependency
# changes. Both the local build and CI regenerate it.
THIRD-PARTY-NOTICES.html
aur/PKGBUILD
