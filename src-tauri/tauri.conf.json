{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "Lychi",
  "version": "0.1.4",
  "identifier": "app.lychi",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:42352",
    "beforeDevCommand": "pnpm vite:dev",
    "beforeBuildCommand": "pnpm vite:build"
  },
  "app": {
    "windows": [
      {
        "title": "Lychi",
        "width": 1920,
        "height": 1080,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "center": true,
        "transparent": true,
        "visible": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; font-src 'self'; connect-src 'self' https: ipc: http://ipc.localhost; frame-ancestors 'none';",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "/usr/share/icons/**",
          "/usr/share/pixmaps/**",
          "/opt/**",
          "/var/lib/flatpak/exports/share/icons/**",
          "/var/lib/flatpak/app/**/icons/**",
          "/var/lib/snapd/desktop/icons/**",
          "$HOME/.local/share/icons/**",
          "$HOME/.local/share/flatpak/exports/share/icons/**",
          "$HOME/.local/share/flatpak/app/**/icons/**",
          "$HOME/.local/share/lychi/icon-cache/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb",
      "rpm"
    ],
    "externalBin": [
      "binaries/lychi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libgtk-layer-shell0"
        ],
        "recommends": [
          "libayatana-appindicator3-1"
        ]
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3",
          "gtk-layer-shell"
        ]
      }
    },
    "resources": {
      "../THIRD-PARTY-NOTICES.html": "THIRD-PARTY-NOTICES.html"
    }
  },
  "plugins": {
    "_updater_README": [
      "DECISION 2026-08-07: the updater is wired but deliberately OFF for v0.1.0.",
      "Enable it at v0.2.0 only if AppImage users turn out to matter — Flatpak,",
      "AUR, dnf and apt all update themselves, and every key you do not hold is",
      "a key that cannot leak. Rotation is the reason for the caution: the public",
      "key is compiled into installed binaries, so replacing it needs a release",
      "signed with the OLD key that carries the NEW one. Sign with the new key",
      "first and every existing install is stranded on a manual re-download.",
      "",
      "To enable it:",
      "  1. pnpm tauri signer generate -w ~/.tauri/lychi.key   (keep the private key + password secret)",
      "  2. rename this key to \"updater\" and paste the PUBLIC key into \"pubkey\" below",
      "  3. set bundle.createUpdaterArtifacts to true",
      "  4. add TAURI_SIGNING_PRIVATE_KEY and TAURI_SIGNING_PRIVATE_KEY_PASSWORD as GitHub secrets",
      "Only the AppImage self-updates; deb/rpm/Flatpak are gated at runtime by lychi_core::install."
    ],
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNCOEQ5RUQxQjlDMUU5QzgKUldUSTZjRzUwWjZOTzVCK3dIcjBERGhhWGdlTjV4R1c1Z1B1MlhMSXBVYW5YME1yc3NHaDZJYkkK",
      "endpoints": [
        "https://github.com/Shansabry/lychi-core/releases/latest/download/latest.json"
      ]
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "lychi"
        ]
      }
    }
  }
}
