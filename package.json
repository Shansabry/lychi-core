{
  "name": "lychi",
  "private": true,
  "version": "0.1.1",
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "RUST_LOG=debug tauri dev",
    "dev:local-ai": "RUST_LOG=debug tauri dev -- --features local-ai",
    "build": "pnpm build:cli && pnpm notices && NO_STRIP=1 tauri build --bundles appimage --features local-ai && bash scripts/fix-appimage-codecs.sh",
    "build:debug": "RUST_LOG=debug tauri build --debug --no-bundle",
    "vite:dev": "vite dev",
    "vite:build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "format": "biome format --write src/",
    "format:rust": "cargo fmt --all",
    "clippy": "cargo clippy --workspace",
    "test": "cargo test --workspace",
    "test:core": "cargo test -p lychi-core",
    "test:fe": "vitest run",
    "clean": "rm -rf .svelte-kit node_modules/.vite",
    "tauri": "tauri",
    "build:cli": "cargo build --release -p lychi-cli && mkdir -p src-tauri/binaries && cp target/release/lychi src-tauri/binaries/lychi-x86_64-unknown-linux-gnu",
    "build:all": "pnpm build:cli && NO_STRIP=1 tauri build",
    "notices": "cargo about generate about.hbs --features local-ai -o THIRD-PARTY-NOTICES.html",
    "hooks": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.2",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@sveltejs/adapter-static": "^3",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^7",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^26.1.1",
    "jsdom": "^30.0.1",
    "lefthook": "^2.1.10",
    "svelte": "^5",
    "svelte-check": "^4",
    "typescript": "^5",
    "vite": "^8",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@tauri-apps/plugin-updater": "^2.10.1",
    "ansi-to-html": "^0.7.2",
    "dompurify": "^3.3.1",
    "highlight.js": "^11.11.1",
    "lucide-svelte": "^1",
    "marked": "^18"
  }
}
