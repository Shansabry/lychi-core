{
  "name": "lychi",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "RUST_LOG=debug tauri dev",
    "build": "NO_STRIP=1 tauri build --bundles appimage",
    "build:debug": "RUST_LOG=debug tauri build --debug --no-bundle",
    "vite:dev": "vite dev",
    "vite:build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "format": "biome format --write src/",
    "format:rust": "cargo fmt --all",
    "clippy": "cargo clippy --workspace",
    "test": "cargo test --workspace",
    "test:core": "cargo test -p lychi-core",
    "clean": "rm -rf .svelte-kit node_modules/.vite",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.2",
    "@sveltejs/adapter-static": "^3",
    "@sveltejs/kit": "^2",
    "@sveltejs/vite-plugin-svelte": "^6",
    "@tauri-apps/api": "^2",
    "@tauri-apps/cli": "^2",
    "svelte": "^5",
    "svelte-check": "^4",
    "typescript": "^5",
    "vite": "^7"
  },
  "dependencies": {
    "ansi-to-html": "^0.7.2",
    "lucide-svelte": "^0.574.0",
    "marked": "^17.0.3"
  }
}
